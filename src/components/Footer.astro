---
import { site, links } from '../data/site';
import type { Lang } from '../data/site';

interface Props {
  lang?: Lang;
}

const { lang = 'es' } = Astro.props;
const year = new Date().getFullYear();
const madeWith = lang === 'en' ? `Built with Astro · ${year}` : `Hecho con Astro · ${year}`;
---

<footer class="site-footer">
  <hr class="hr" />
  <div class="container footer-inner">
    <div class="footer-meta">
      <span class="mono">{site.name}</span>
      <span class="muted">{madeWith}</span>
    </div>

    <nav class="footer-links" aria-label={lang === 'en' ? 'Links' : 'Enlaces'}>
      <a class="link" href={`mailto:${links.email}`}>Email</a>
      <a class="link" href={links.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
      <a class="link" href={links.github} target="_blank" rel="noopener noreferrer">GitHub</a>
      <a class="link" href={links.cv}>CV</a>
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--rhythm);
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 2rem 3rem;
    font-size: 0.8rem;
  }

  .footer-meta {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(1rem, 4vw, 1.75rem);
    font-family: var(--font-mono);
    font-size: 0.78rem;
  }
</style>
