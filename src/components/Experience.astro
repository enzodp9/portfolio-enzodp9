---
import type { Lang } from '../data/site';

interface Props {
  lang?: Lang;
}

const { lang = 'es' } = Astro.props;

const content = {
  es: {
    sectionTitle: 'Experiencia Profesional',
    experiencia: [
      {
        role: 'Software & AI Engineer',
        org: 'Cantera La Chola II S.A. / UD-TI para la Industria',
        dates: 'Sep. 2024 – Actualidad',
        location: 'Concepción del Uruguay',
        desc: 'Me incorporé a una operación minera que no tenía área de sistemas y armé su stack interno desde cero. Arranqué con Microsoft Power Platform (Power Apps, Power Automate, Dataverse, Power BI) y sumé arquitecturas de datos e IA sobre Python y Azure, para digitalizar logística, laboratorio, producción y análisis. Desde 2026 continúo el rol en UD-TI para la Industria, la unidad creada para llevar estas soluciones a clientes externos.',
      },
      {
        role: 'Software Engineer',
        org: 'MIGA Software',
        dates: '2025 – Actualidad',
        location: 'Producto SaaS propio',
        desc: 'Producto propio: diseño y desarrollo un SaaS de gestión para panaderías y pastelerías (ventas, producción, recetas, stock y caja), hoy en producción. A cargo de la arquitectura, el desarrollo full-stack y el despliegue en Azure con CI/CD en GitHub Actions.',
      },
      {
        role: 'Becario de Investigación',
        org: 'Grupo de Investigación en Gestión de Operaciones y Logística (UTN)',
        dates: 'Mar. 2023 – Nov. 2023',
        desc: 'Optimicé una línea de producción de vibrocompactadores con un modelo de simulación en SIMIO, en un proyecto junto a Pecarí Implementos. Relevé, procesé y analicé los datos en Python para construir y validar el modelo.',
      },
      {
        role: 'Desarrollador Full Stack',
        org: 'AReNe (Asociación de Rehabilitación Neurológica)',
        dates: 'Mar. 2022 – Dic. 2022',
        location: 'Concepción del Uruguay',
        desc: 'Desarrollé un sistema de gestión de pacientes, turnos e historiales clínicos, del relevamiento al despliegue: backend con NestJS, GraphQL y MySQL, y frontend en React.',
      },
    ],
  },
  en: {
    sectionTitle: 'Professional Experience',
    experiencia: [
      {
        role: 'Software & AI Engineer',
        org: 'Cantera La Chola II S.A. / UD-TI para la Industria',
        dates: 'Sep. 2024 – Present',
        location: 'Concepción del Uruguay',
        desc: "I joined a mining operation that had no systems department and built its internal stack from scratch. I started with Microsoft Power Platform (Power Apps, Power Automate, Dataverse, Power BI) and added data and AI architectures on Python and Azure to digitize logistics, laboratory, production, and analysis. Since 2026 I've continued the role within UD-TI para la Industria, the unit created to bring these solutions to external clients.",
      },
      {
        role: 'Software Engineer',
        org: 'MIGA Software',
        dates: '2025 – Present',
        location: 'Own SaaS product',
        desc: "My own product: I design and develop a management SaaS for bakeries and pastry shops (sales, production, recipes, inventory, and cash flow), now in production. I'm in charge of the architecture, full-stack development, and deployment on Azure with CI/CD in GitHub Actions.",
      },
      {
        role: 'Research Fellow',
        org: 'Operations and Logistics Management Research Group (UTN)',
        dates: 'Mar. 2023 – Nov. 2023',
        desc: 'I optimized a vibratory compactor production line with a simulation model in SIMIO, on a project alongside Pecarí Implementos. I gathered, processed, and analyzed the data in Python to build and validate the model.',
      },
      {
        role: 'Full Stack Developer',
        org: 'AReNe (Asociación de Rehabilitación Neurológica)',
        dates: 'Mar. 2022 – Dec. 2022',
        location: 'Concepción del Uruguay',
        desc: 'I developed a patient, appointment, and clinical record management system end to end — from requirements gathering to deployment: backend with NestJS, GraphQL, and MySQL, and frontend in React.',
      },
    ],
  },
}[lang];

const { sectionTitle, experiencia } = content;
---

<section id="experiencia" class="cv container" aria-labelledby="exp-title">
  <header class="cv-head" data-reveal="rule">
    <h2 id="exp-title" class="cv-title">{sectionTitle}</h2>
  </header>

  <ol class="cv-list timeline">
    {experiencia.map((e, i) => (
      <li class="entry" data-reveal="rise" style={`--i: ${i}`}>
        <span class="dot" aria-hidden="true"></span>
        <div class="entry-top">
          <h3 class="entry-role">{e.role}</h3>
          <span class="entry-dates mono">{e.dates}</span>
        </div>
        <p class="entry-org">{e.location ? `${e.org} · ${e.location}` : e.org}</p>
        <p class="entry-desc">{e.desc}</p>
      </li>
    ))}
  </ol>
</section>

<style>
  .cv {
    margin-top: var(--rhythm);
  }

  .cv-head {
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--line);
  }

  .cv-title {
    font-size: clamp(1.6rem, 4vw, 2.2rem);
    letter-spacing: -0.02em;
    line-height: 1;
  }

  .cv-list {
    list-style: none;
  }

  /* Timeline: línea vertical + puntos cobalto por entrada -------------- */
  .timeline {
    position: relative;
    margin-top: 1.75rem;
    padding-left: 1.5rem;
    border-left: 1px solid var(--line);
  }

  .entry {
    position: relative;
    padding-bottom: 2rem;
  }

  .entry:last-child {
    padding-bottom: 0;
  }

  .dot {
    position: absolute;
    left: -1.5rem;
    top: 0.35rem;
    transform: translateX(-50%);
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--paper);
    border: 2px solid var(--accent);
  }

  .entry-top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.2rem 1.25rem;
    flex-wrap: wrap;
  }

  .entry-role {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.05rem;
    letter-spacing: -0.01em;
  }

  .entry-dates {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.04em;
    color: var(--muted);
    white-space: nowrap;
  }

  .entry-org {
    margin: 0.3rem 0 0;
    font-style: italic;
    color: var(--muted);
    font-size: 0.84rem;
  }

  .entry-desc {
    margin: 0.55rem 0 0;
    font-size: 0.9rem;
    color: var(--ink-soft);
    max-width: 68ch;
  }

  @media (max-width: 460px) {
    .timeline {
      padding-left: 1.15rem;
    }

    .dot {
      left: -1.15rem;
    }
  }
</style>
