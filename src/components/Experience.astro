---
import type { Lang } from '../data/site';

interface Props {
  lang?: Lang;
}

const { lang = 'es' } = Astro.props;

const content = {
  es: {
    sectionTitle: 'Experiencia Profesional',
    experiencia: [
      {
        role: 'Software & AI Engineer',
        org: 'Cantera La Chola II S.A. / UD-TI para la Industria',
        dates: 'Sep. 2024 – Actualidad',
        location: 'Concepción del Uruguay',
        desc: 'Desarrollo soluciones para la digitalización de procesos industriales, inicialmente mediante Microsoft Power Platform (Power Apps, Power Automate, Dataverse y Power BI) y posteriormente con arquitecturas de datos e inteligencia artificial basadas en Python y Azure. Diseño e implemento aplicaciones, automatizaciones, integraciones y soluciones de IA para optimizar procesos de logística, laboratorio, producción y análisis de datos. Desde 2026 continúo el mismo rol dentro de UD-TI para la Industria, unidad creada para extender estas soluciones a clientes externos.',
      },
      {
        role: 'Fundador | Software Engineer',
        org: 'MIGA Software',
        dates: '2025 – Actualidad',
        location: 'Producto SaaS propio',
        desc: 'Diseño y desarrollo un SaaS para la gestión integral de panaderías y pastelerías, cubriendo ventas, producción, recetas, stock y caja. Lidero la arquitectura, el desarrollo full stack y el despliegue en Azure, implementando procesos de CI/CD con GitHub Actions. El producto se encuentra en producción desde mayo de 2026.',
      },
      {
        role: 'Becario de Investigación',
        org: 'Grupo de Investigación en Gestión de Operaciones y Logística',
        dates: 'Mar. 2023 – Nov. 2023',
        location: 'Universidad Tecnológica Nacional – Facultad Regional Concepción del Uruguay',
        desc: 'Participé en un proyecto de simulación industrial junto a Pecarí Implementos para optimizar una línea de producción mediante SIMIO. Realicé relevamiento, procesamiento y análisis de datos en Python para construir y validar el modelo de simulación.',
      },
      {
        role: 'Desarrollador Full Stack',
        org: 'AReNe (Asociación de Rehabilitación Neurológica)',
        dates: 'Mar. 2022 – Dic. 2022',
        location: 'Concepción del Uruguay',
        desc: 'Participé en el desarrollo de un sistema de gestión para pacientes, turnos e historiales clínicos, implementando funcionalidades backend con NestJS, GraphQL y MySQL, y frontend en React.',
      },
    ],
  },
  en: {
    sectionTitle: 'Professional Experience',
    experiencia: [
      {
        role: 'Software & AI Engineer',
        org: 'Cantera La Chola II S.A. / UD-TI para la Industria',
        dates: 'Sep. 2024 – Present',
        location: 'Concepción del Uruguay',
        desc: "I develop solutions for the digitalization of industrial processes, initially through Microsoft Power Platform (Power Apps, Power Automate, Dataverse, and Power BI) and later through data and AI architectures based on Python and Azure. I design and implement applications, automations, integrations, and AI solutions to optimize logistics, laboratory, production, and data analysis processes. Since 2026 I've continued the same role within UD-TI para la Industria, a unit created to extend these solutions to external clients.",
      },
      {
        role: 'Founder | Software Engineer',
        org: 'MIGA Software',
        dates: '2025 – Present',
        location: 'Own SaaS product',
        desc: 'I design and develop a SaaS platform for the end-to-end management of bakeries and pastry shops, covering sales, production, recipes, inventory, and cash flow. I lead the architecture, full-stack development, and deployment on Azure, implementing CI/CD pipelines with GitHub Actions. The product has been in production since May 2026.',
      },
      {
        role: 'Research Fellow',
        org: 'Operations and Logistics Management Research Group',
        dates: 'Mar. 2023 – Nov. 2023',
        location: 'Universidad Tecnológica Nacional – Concepción del Uruguay Regional Faculty',
        desc: 'I took part in an industrial simulation project alongside Pecarí Implementos to optimize a production line using SIMIO. I carried out data gathering, processing, and analysis in Python to build and validate the simulation model.',
      },
      {
        role: 'Full Stack Developer',
        org: 'AReNe (Asociación de Rehabilitación Neurológica)',
        dates: 'Mar. 2022 – Dec. 2022',
        location: 'Concepción del Uruguay',
        desc: 'I took part in developing a management system for patients, appointments, and clinical records, implementing backend features with NestJS, GraphQL, and MySQL, and frontend with React.',
      },
    ],
  },
}[lang];

const { sectionTitle, experiencia } = content;
---

<section id="experiencia" class="cv container" aria-labelledby="exp-title">
  <header class="cv-head" data-reveal="rule">
    <h2 id="exp-title" class="cv-title">{sectionTitle}</h2>
  </header>

  <ol class="cv-list timeline">
    {experiencia.map((e, i) => (
      <li class="entry" data-reveal="rise" style={`--i: ${i}`}>
        <span class="dot" aria-hidden="true"></span>
        <div class="entry-top">
          <h3 class="entry-role">{e.role}</h3>
          <span class="entry-dates mono">{e.dates}</span>
        </div>
        <p class="entry-org">{e.location ? `${e.org} · ${e.location}` : e.org}</p>
        <p class="entry-desc">{e.desc}</p>
      </li>
    ))}
  </ol>
</section>

<style>
  .cv {
    margin-top: var(--rhythm);
  }

  .cv-head {
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--line);
  }

  .cv-title {
    font-size: clamp(1.6rem, 4vw, 2.2rem);
    letter-spacing: -0.02em;
    line-height: 1;
  }

  .cv-list {
    list-style: none;
  }

  /* Timeline: línea vertical + puntos cobalto por entrada -------------- */
  .timeline {
    position: relative;
    margin-top: 1.75rem;
    padding-left: 1.5rem;
    border-left: 1px solid var(--line);
  }

  .entry {
    position: relative;
    padding-bottom: 2rem;
  }

  .entry:last-child {
    padding-bottom: 0;
  }

  .dot {
    position: absolute;
    left: -1.5rem;
    top: 0.35rem;
    transform: translateX(-50%);
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--paper);
    border: 2px solid var(--accent);
  }

  .entry-top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.2rem 1.25rem;
    flex-wrap: wrap;
  }

  .entry-role {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.05rem;
    letter-spacing: -0.01em;
  }

  .entry-dates {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.04em;
    color: var(--muted);
    white-space: nowrap;
  }

  .entry-org {
    margin: 0.3rem 0 0;
    font-style: italic;
    color: var(--muted);
    font-size: 0.84rem;
  }

  .entry-desc {
    margin: 0.55rem 0 0;
    font-size: 0.9rem;
    color: var(--ink-soft);
    max-width: 68ch;
  }

  @media (max-width: 460px) {
    .timeline {
      padding-left: 1.15rem;
    }

    .dot {
      left: -1.15rem;
    }
  }
</style>
