---
import { site, links } from '../data/site';
import type { Lang } from '../data/site';
import Icon from './Icon.astro';

interface Props {
  lang?: Lang;
}

const { lang = 'es' } = Astro.props;
const githubHandle = links.github.replace(/^https?:\/\/(www\.)?github\.com\//, '@');

const labels = {
  es: { location: 'ubicación', contact: 'contacto', cv: 'cv', profiles: 'perfiles', downloadPdf: 'descargar PDF' },
  en: { location: 'location', contact: 'contact', cv: 'cv', profiles: 'profiles', downloadPdf: 'download PDF' },
}[lang];
---

<section class="hero container" aria-labelledby="hero-title">
  <div class="masthead" aria-hidden="true">
    <span class="mast-left">
      <span class="mast-id">{site.mark}-001</span>
      <span class="mast-label">· Portfolio</span>
    </span>
    <span class="mast-rev">Rev 2026.06</span>
  </div>

  <h1 id="hero-title" class="hero-title">
    {site.name}<span class="cursor" aria-hidden="true">▍</span>
  </h1>

  <p class="hero-role">{site.tagline[lang]}</p>

  <dl class="hero-spec">
    <div class="field">
      <dt><span class="field-icon"><Icon name="location" /></span> {labels.location}</dt>
      <dd>{site.location}</dd>
    </div>
    <div class="field">
      <dt><span class="field-icon"><Icon name="mail" /></span> {labels.contact}</dt>
      <dd><a class="link" href={`mailto:${links.email}`}>{links.email}</a></dd>
    </div>
    <div class="field">
      <dt><span class="field-icon"><Icon name="file" /></span> {labels.cv}</dt>
      <dd><a class="link" href={links.cv}>{labels.downloadPdf}</a></dd>
    </div>
    <div class="field">
      <dt><span class="field-icon"><Icon name="external" /></span> {labels.profiles}</dt>
      <dd class="profile-links">
        <a class="link profile-link" href={links.github} target="_blank" rel="noopener noreferrer">
          <Icon name="github" /> {githubHandle}
        </a>
        <a class="link profile-link" href={links.linkedin} target="_blank" rel="noopener noreferrer">
          <Icon name="linkedin" /> LinkedIn
        </a>
      </dd>
    </div>
  </dl>
</section>

<style>
  .hero {
    padding-block: clamp(3rem, 9vw, 6rem) 0;
  }

  /* Masthead / titleblock ------------------------------------------------ */
  .masthead {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding-bottom: 0.85rem;
    border-bottom: 1px solid var(--line);
  }

  .mast-left {
    display: inline-flex;
    align-items: baseline;
    gap: 0.55rem;
  }

  .mast-id {
    color: var(--ink);
    font-weight: 700;
  }

  .mast-label,
  .mast-rev {
    color: var(--muted);
  }

  /* Title ----------------------------------------------------------------- */
  .hero-title {
    font-size: clamp(2.1rem, 8vw, 4.25rem);
    letter-spacing: -0.035em;
    line-height: 1.05;
    margin: clamp(1.75rem, 5vw, 2.75rem) 0 0;
    text-wrap: balance;
    overflow-wrap: break-word;
  }

  .cursor {
    color: var(--accent);
    font-weight: 400;
    margin-left: 0.05em;
    animation: blink 1.1s steps(1) infinite;
  }

  @keyframes blink {
    0%,
    50% {
      opacity: 1;
    }
    50.01%,
    100% {
      opacity: 0;
    }
  }

  .hero-role {
    font-family: var(--font-mono);
    font-weight: 400;
    font-size: clamp(0.92rem, 2vw, 1.05rem);
    letter-spacing: -0.005em;
    line-height: 1.5;
    color: var(--muted);
    max-width: 52ch;
    margin: 1.35rem 0 2.5rem;
    text-wrap: balance;
  }

  /* Spec strip -------------------------------------------------------------
     Sin cajitas: una sola hairline arriba de toda la fila, columnas al aire
     sin bordes internos. */
  .hero-spec {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
    border-top: 1px solid var(--line);
    padding-top: 1.25rem;
  }

  .field {
    display: grid;
    gap: 0.5rem;
    align-content: start;
  }

  .field dt {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: 0.64rem;
    color: var(--muted);
  }

  .field-icon {
    display: inline-flex;
    color: var(--accent);
    font-size: 0.95em;
  }

  .field dd {
    margin: 0;
    font-size: 0.82rem;
    line-height: 1.45;
  }

  .profile-links {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .profile-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    width: fit-content;
  }

  /* Entrada escalonada (una sola vez, en carga) -------------------------- */
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(0.7rem);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .masthead,
  .hero-title,
  .hero-role,
  .hero-spec {
    animation: rise 0.7s cubic-bezier(0.22, 1, 0.36, 1) backwards;
  }

  .masthead {
    animation-delay: 0.05s;
  }
  .hero-title {
    animation-delay: 0.14s;
  }
  .hero-role {
    animation-delay: 0.24s;
  }
  .hero-spec {
    animation-delay: 0.32s;
  }

  @media (prefers-reduced-motion: reduce) {
    .masthead,
    .hero-title,
    .hero-role,
    .hero-spec {
      animation: none;
    }
  }

  @media (max-width: 860px) {
    .hero-spec {
      grid-template-columns: repeat(2, 1fr);
      row-gap: 1.5rem;
    }
  }

  @media (max-width: 460px) {
    .hero-spec {
      grid-template-columns: 1fr;
    }
  }
</style>
